<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SMM Panel — Auto Post</title>
<style>
  :root { --bg:#0b0f19; --sidebar:#111827; --card:#161e2e; --card2:#1e2740; --border:#24315a; --text:#e6ecff; --muted:#8894b8; --accent:#4f7bff; --green:#34d399; --red:#f87171; --amber:#fbbf24; --purple:#a855f7; --pink:#ec4899; }
  * { box-sizing:border-box; margin:0; padding:0; }
  body { font-family:'Segoe UI',system-ui,sans-serif; background:var(--bg); color:var(--text); min-height:100vh; display:flex; }
  /* Sidebar */
  .sidebar { width:240px; background:var(--sidebar); border-right:1px solid var(--border); padding:20px 14px; display:flex; flex-direction:column; gap:6px; position:fixed; top:0; left:0; bottom:0; overflow-y:auto; z-index:10; }
  .sidebar .brand { display:flex; align-items:center; gap:10px; padding:4px 10px 16px; font-size:18px; font-weight:700; }
  .sidebar .brand .logo { width:32px; height:32px; background:var(--accent); border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:18px; }
  .sidebar .sec-label { font-size:11px; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); padding:14px 10px 6px; }
  .sidebar .nav-item { display:flex; align-items:center; gap:11px; padding:9px 12px; border-radius:9px; cursor:pointer; font-size:14px; color:var(--muted); transition:.15s; border:1px solid transparent; }
  .sidebar .nav-item:hover { background:var(--card); color:var(--text); }
  .sidebar .nav-item.active { background:var(--accent); color:#fff; }
  .sidebar .nav-item .ic { width:20px; text-align:center; }
  .sidebar .nav-item.active .badge-c { display:none; }
  .sidebar .foot { margin-top:auto; font-size:12px; color:#55628a; padding:12px 10px; }
  /* Main */
  .main { flex:1; margin-left:240px; padding:22px 28px; max-width:1100px; }
  .main .page-title { font-size:22px; font-weight:700; margin-bottom:4px; }
  .main .page-sub { color:var(--muted); font-size:13px; margin-bottom:20px; }
  .stats { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:22px; }
  .stat { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:16px; }
  .stat .num { font-size:26px; font-weight:700; }
  .stat .lbl { color:var(--muted); font-size:12px; margin-top:3px; }
  .card { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:20px; }
  .card-title { font-size:15px; font-weight:600; margin-bottom:14px; color:var(--accent); }
  .grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  form { display:flex; flex-direction:column; gap:10px; }
  label { font-size:13px; color:var(--muted); }
  input, textarea, select { background:var(--card2); border:1px solid var(--border); color:var(--text); border-radius:8px; padding:10px 12px; font-size:14px; width:100%; }
  textarea { resize:vertical; min-height:70px; }
  button { background:var(--accent); color:#fff; border:none; border-radius:8px; padding:11px; font-size:14px; font-weight:600; cursor:pointer; }
  button:hover { filter:brightness(1.12); }
  button.green { background:var(--green); }
  button.ghost { background:transparent; border:1px solid var(--border); color:var(--text); }
  button:disabled { opacity:.65; cursor:not-allowed; }
  /* Spinner */
  .spinner { display:inline-block; width:14px; height:14px; border:2px solid rgba(255,255,255,.35); border-top-color:#fff; border-radius:50%; animation:spin .7s linear infinite; vertical-align:middle; margin-right:7px; }
  @keyframes spin { to { transform:rotate(360deg); } }
  button.loading { display:inline-flex; align-items:center; justify-content:center; gap:7px; }
  table { width:100%; border-collapse:collapse; font-size:13px; }
  th,td { text-align:left; padding:9px 10px; border-bottom:1px solid var(--border); }
  th { color:var(--muted); font-weight:600; font-size:12px; }
  .card > .scroll { border:1px solid var(--border); border-radius:10px; overflow:hidden; }
  .dt-scroll { border:1px solid var(--border); border-radius:10px; }
  .card > .scroll table, .dt-scroll table { min-width:640px; }
  .card > .scroll thead, .dt-scroll thead { position:sticky; top:0; background:var(--card2); z-index:1; }
  .card > .scroll thead th, .dt-scroll thead th { padding:11px 12px; border-bottom:1px solid var(--border); }
  .card > .scroll tbody tr, .dt-scroll tbody tr { transition:background .15s; }
  .card > .scroll tbody tr:hover, .dt-scroll tbody tr:hover { background:rgba(79,123,255,.07); }
  .card > .scroll tbody tr:last-child td, .dt-scroll tbody tr:last-child td { border-bottom:none; }
  .card > .scroll td, .dt-scroll td { padding:11px 12px; vertical-align:middle; }
  /* Avatar akun */
  .acc-cell { display:flex; align-items:center; gap:10px; }
  .acc-avatar { width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px; color:#fff; flex-shrink:0; }
  .acc-avatar.fb { background:linear-gradient(135deg,#4f7bff,#2f55d4); }
  .acc-avatar.ig { background:linear-gradient(135deg,#ec4899,#a855f7); }
  .acc-avatar.tiktok { background:linear-gradient(135deg,#a855f7,#6d28d9); }
  .acc-avatar.other { background:linear-gradient(135deg,#64748b,#475569); }
  .acc-name { font-weight:600; color:var(--text); }
  .acc-email { font-size:12px; color:var(--muted); margin-top:2px; }
  .platform-cell { display:flex; align-items:center; gap:7px; }
  .platform-ic { width:24px; height:24px; border-radius:6px; display:flex; align-items:center; justify-content:center; font-size:12px; }
  .platform-ic.fb { background:rgba(79,123,255,.15); color:var(--accent); }
  .platform-ic.ig { background:rgba(236,72,153,.15); color:var(--pink); }
  .platform-ic.tiktok { background:rgba(168,85,247,.15); color:var(--purple); }
  .status-cell { display:flex; align-items:center; gap:6px; }
  .status-dot { width:7px; height:7px; border-radius:50%; display:inline-block; }
  .status-dot.good { background:var(--green); }
  .status-dot.warn { background:var(--amber); }
  .status-dot.bad { background:var(--red); }
  /* Kolom aksi lebih rapi */
  .act-col { display:flex; flex-direction:row; gap:5px; min-width:auto; }
  .act-col button { width:auto; padding:6px 11px; font-size:12px; white-space:nowrap; border-radius:7px; }
  /* DataTable toolbar */
  .dt-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; flex-wrap:wrap; }
  .dt-toolbar .dt-info { font-size:13px; color:var(--muted); }
  .dt-toolbar .dt-search { display:flex; align-items:center; gap:8px; }
  .dt-toolbar .dt-search input { background:var(--card2); border:1px solid var(--border); color:var(--text); border-radius:8px; padding:8px 12px 8px 34px; font-size:13px; width:220px; transition:.2s; }
  .dt-toolbar .dt-search input:focus { border-color:var(--accent); outline:none; width:260px; }
  .dt-search-wrap { position:relative; }
  .dt-search-wrap::before { content:'🔍'; position:absolute; left:10px; top:50%; transform:translateY(-50%); font-size:13px; opacity:.6; }
  .dt-footer { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:12px; flex-wrap:wrap; }
  .dt-pages { display:flex; gap:4px; align-items:center; }
  .dt-pages button { background:var(--card2); border:1px solid var(--border); color:var(--text); padding:6px 11px; border-radius:6px; font-size:12px; cursor:pointer; transition:.15s; min-width:32px; text-align:center; }
  .dt-pages button:hover { border-color:var(--accent); color:var(--accent); }
  .dt-pages button.active { background:var(--accent); border-color:var(--accent); color:#fff; }
  .dt-pages button:disabled { opacity:.4; cursor:default; }
  .dt-sort { cursor:pointer; user-select:none; white-space:nowrap; }
  .dt-sort:hover { color:var(--accent); }
  .dt-sort::after { content:' ⇅'; font-size:10px; opacity:.4; }
  .dt-sort.asc::after { content:' ↑'; opacity:1; }
  .dt-sort.desc::after { content:' ↓'; opacity:1; }
  .dt-empty { text-align:center; padding:40px 20px; color:var(--muted); font-size:14px; }
  .dt-empty-icon { font-size:36px; margin-bottom:10px; opacity:.5; }
  .badge { padding:2px 9px; border-radius:20px; font-size:11px; font-weight:600; display:inline-block; }
  .b-active,.b-done,.b-posted { background:rgba(52,211,153,.15); color:var(--green); }
  .b-pending,.b-login_ok { background:rgba(251,191,36,.15); color:var(--amber); }
  .b-failed,.b-error,.b-login_failed,.b-checkpoint { background:rgba(248,113,113,.15); color:var(--red); }
  .b-fb { background:rgba(79,123,255,.15); color:var(--accent); }
  .b-tiktok { background:rgba(168,85,247,.15); color:var(--purple); }
  .b-ig { background:rgba(236,72,153,.15); color:var(--pink); }
  .btn-login { background:var(--green); padding:5px 12px; font-size:12px; }
  .btn-open { background:var(--accent); padding:5px 14px; font-size:12px; }
  .btn-del { background:transparent; border:1px solid var(--red); color:var(--red); padding:4px 10px; font-size:11px; }
  .act-group { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
  .act-group button { border-radius:7px; }
  .act-main { background:var(--accent); color:#fff; border:none; font-weight:600; cursor:pointer; }
  .act-main.green { background:var(--green); }
  .act-edit { background:var(--card2); border:1px solid var(--border); color:var(--text); cursor:pointer; transition:.2s; }
  .act-edit:hover { background:var(--accent); border-color:var(--accent); color:#fff; }
  .act-del { background:transparent; border:1px solid var(--red); color:var(--red); cursor:pointer; }
  .toast { position:fixed; bottom:20px; right:20px; background:var(--card2); border:1px solid var(--border); padding:13px 20px; border-radius:10px; font-size:14px; opacity:0; transition:.3s; z-index:99; max-width:340px; }
  .toast.show { opacity:1; }
  /* Modal konfirmasi */
  .modal-overlay { position:fixed; inset:0; background:rgba(8,10,18,.72); backdrop-filter:blur(3px); display:flex; align-items:center; justify-content:center; z-index:1000; opacity:0; visibility:hidden; transition:.2s; }
  .modal-overlay.show { opacity:1; visibility:visible; }
  .modal-box { background:var(--card); border:1px solid var(--border); border-radius:14px; padding:24px 26px; max-width:420px; width:92%; box-shadow:0 20px 60px rgba(0,0,0,.5); transform:scale(.94); transition:.18s; }
  .modal-overlay.show .modal-box { transform:scale(1); }
  .modal-icon { font-size:30px; text-align:center; margin-bottom:8px; }
  .modal-title { font-size:16px; font-weight:700; text-align:center; margin-bottom:8px; color:var(--text); }
  .modal-msg { font-size:13px; color:var(--muted); text-align:center; line-height:1.5; margin-bottom:20px; }
  .modal-btns { display:flex; gap:10px; }
  /* Modal CRUD untuk Form */
  .modal-form { background:var(--card); border:1px solid var(--border); border-radius:14px; padding:28px; max-width:540px; width:94%; box-shadow:0 20px 60px rgba(0,0,0,.5); transform:scale(.94); transition:.18s; max-height:90vh; overflow-y:auto; }
  .modal-overlay.show .modal-form { transform:scale(1); }
  .modal-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; }
  .modal-header h3 { font-size:18px; font-weight:700; color:var(--text); }
  .modal-close { background:transparent; border:none; color:var(--muted); font-size:24px; cursor:pointer; padding:0; width:32px; height:32px; display:flex; align-items:center; justify-content:center; border-radius:6px; }
  .modal-close:hover { background:var(--card2); color:var(--text); }
  .modal-btns button { flex:1; padding:11px; font-size:14px; }
  .muted { color:var(--muted); }
  .scroll { overflow-x:auto; max-height:340px; overflow-y:auto; }
  .dt-scroll { overflow-x:auto; }
  .history-empty { color:var(--muted); text-align:center; padding:30px; }
  .acc-select-row { display:flex; gap:8px; }
  .acc-select-row label { flex:1; }
  /* Progress Modal */
  .progress-overlay { position:fixed; inset:0; background:rgba(8,10,18,.85); backdrop-filter:blur(4px); display:flex; align-items:center; justify-content:center; z-index:2000; opacity:0; visibility:hidden; transition:.3s; }
  .progress-overlay.show { opacity:1; visibility:visible; }
  .progress-box { background:var(--card); border:1px solid var(--border); border-radius:16px; padding:28px 32px; max-width:480px; width:94%; box-shadow:0 24px 70px rgba(0,0,0,.6); }
  .progress-header { text-align:center; margin-bottom:24px; }
  .progress-header .icon { font-size:42px; margin-bottom:10px; animation:bounce 1.2s ease-in-out infinite; }
  @keyframes bounce { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-8px);} }
  .progress-header .title { font-size:18px; font-weight:700; color:var(--text); margin-bottom:6px; }
  .progress-header .subtitle { font-size:13px; color:var(--muted); }
  .progress-steps { display:flex; flex-direction:column; gap:14px; margin-bottom:20px; }
  .progress-step { display:flex; align-items:center; gap:12px; padding:12px 14px; background:var(--card2); border:1px solid var(--border); border-radius:10px; transition:.25s; }
  .progress-step.active { border-color:var(--accent); background:rgba(79,123,255,.08); }
  .progress-step.completed { border-color:var(--green); background:rgba(52,211,153,.08); }
  .progress-step.failed { border-color:var(--red); background:rgba(248,113,113,.08); }
  .progress-step .step-icon { width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:16px; background:var(--sidebar); border:1px solid var(--border); flex-shrink:0; }
  .progress-step.active .step-icon { background:var(--accent); border-color:var(--accent); animation:pulse 1.5s ease-in-out infinite; }
  .progress-step.completed .step-icon { background:var(--green); border-color:var(--green); }
  .progress-step.failed .step-icon { background:var(--red); border-color:var(--red); }
  @keyframes pulse { 0%,100%{transform:scale(1); opacity:1;} 50%{transform:scale(1.08); opacity:.85;} }
  .progress-step .step-content { flex:1; }
  .progress-step .step-title { font-size:14px; font-weight:600; color:var(--text); margin-bottom:2px; }
  .progress-step .step-desc { font-size:12px; color:var(--muted); }
  .progress-step.active .step-desc { color:var(--accent); }
  .progress-step.completed .step-desc { color:var(--green); }
  .progress-step.failed .step-desc { color:var(--red); }
  .progress-bar-container { height:6px; background:var(--card2); border-radius:10px; overflow:hidden; margin-bottom:16px; }
  .progress-bar { height:100%; background:linear-gradient(90deg, var(--accent), var(--purple)); border-radius:10px; transition:width .4s ease; position:relative; }
  .progress-bar::after { content:''; position:absolute; top:0; left:0; right:0; bottom:0; background:linear-gradient(90deg, transparent, rgba(255,255,255,.3), transparent); animation:shimmer 1.5s infinite; }
  @keyframes shimmer { 0%{transform:translateX(-100%);} 100%{transform:translateX(100%);} }
  .progress-footer { text-align:center; font-size:12px; color:var(--muted); }
  @media (max-width:900px){ .sidebar{width:100%; position:static; height:auto; flex-direction:row; flex-wrap:wrap;} .main{margin-left:0;} .stats,.grid-2{grid-template-columns:1fr;} }
</style>
</head>
<body>
<aside class="sidebar">
  <div class="brand"><div class="logo">🚀</div> SMM AutoPost</div>

  <div class="sec-label">Platform</div>
  <div class="nav-item" data-view="fb"><span class="ic">📘</span> Facebook</div>
  <div class="nav-item" data-view="tiktok"><span class="ic">🎵</span> TikTok <span class="muted" style="font-size:11px;">(segera)</span></div>
  <div class="nav-item" data-view="ig"><span class="ic">📸</span> Instagram</div>

  <div class="sec-label">Fitur</div>
  <div class="nav-item" data-panel="accounts"><span class="ic">👥</span> Akun</div>
  <div class="nav-item" data-panel="posting"><span class="ic">✍️</span> Posting</div>
  <div class="nav-item" data-panel="history"><span class="ic">🕘</span> Riwayat</div>
  <div class="nav-item" data-panel="likes"><span class="ic">👍</span> Likes</div>
  <div class="nav-item" data-panel="smmlikes"><span class="ic">🚀</span> SMM Like Panel</div>
  <div class="nav-item" data-panel="iglikes"><span class="ic">❤️</span> Like Instagram</div>
  <div class="nav-item" data-panel="proxy"><span class="ic">🌐</span> Proxy</div>
  <div class="nav-item" data-panel="monitoring"><span class="ic">📊</span> Monitoring</div>
  <div class="nav-item" data-panel="followers"><span class="ic">👤</span> Followers <span class="muted" style="font-size:11px;">(segera)</span></div>
  <div class="nav-item" data-panel="comments"><span class="ic">💬</span> Komentar <span class="muted" style="font-size:11px;">(segera)</span></div>

  <div class="foot">Konsep SMM Panel • v0.2</div>
</aside>

<main class="main">
  <div id="errBanner" style="display:none; background:rgba(248,113,113,.12); border:1px solid var(--red); color:var(--red); border-radius:10px; padding:12px 16px; margin-bottom:18px; font-size:13px; display:flex; justify-content:space-between; align-items:center;">
    <span id="errBannerMsg"></span>
    <button class="ghost" style="color:var(--red); padding:4px 10px; margin-left:12px;" onclick="dismissErr()">Tutup</button>
  </div>
  <!-- ============ AKUN ============ -->
  <section data-page="accounts">
    <div class="page-title">Kelola Akun</div>
    <div class="page-sub" id="accSubTitle">Kelola & login akun social media</div>

    <div class="stats">
      <div class="stat"><div class="num" id="sAccounts">–</div><div class="lbl">Total Akun</div></div>
      <div class="stat"><div class="num" id="sToday">–</div><div class="lbl">Jadwal Hari Ini</div></div>
      <div class="stat"><div class="num" id="sPosted">–</div><div class="lbl">Berhasil Post</div></div>
      <div class="stat"><div class="num" id="sErrors">–</div><div class="lbl">Error</div></div>
    </div>

    <div style="display:flex; gap:10px; margin-bottom:20px; flex-wrap:wrap;">
      <button onclick="openAddAccountModal()" class="green">➕ Tambah Akun</button>
      <button onclick="openBulkImportModal()">📥 Import Akun (Bulk)</button>
    </div>

    <div class="card" style="background:var(--card2); border:1px solid var(--accent);">
      <div class="card-title">🚀 Multiple Run</div>
      <div id="batchToolbar" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
        <div>
          <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Aksi</label>
          <select id="batchAction" style="min-width:130px;">
            <option value="login">🔐 Login</option>
            <option value="like">👍 Like FB</option>
            <option value="ig-like">❤️ Like IG</option>
            <option value="post">📝 Post FB</option>
            <option value="post-ig">📸 Post IG</option>
          </select>
        </div>
        <div id="batchUrlGroup" style="display:none;">
          <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">URL Postingan</label>
          <input type="text" id="batchUrl" placeholder="https://facebook.com/..." style="min-width:300px;">
        </div>
        <div id="batchContentGroup" style="display:none;">
          <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Konten</label>
          <textarea id="batchContent" placeholder="Teks posting..." style="min-width:300px; height:34px; padding:6px 10px;"></textarea>
        </div>
        <div id="batchStatusGroup">
          <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Filter Status</label>
          <select id="batchStatus">
            <option value="">Semua</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
            <option value="checkpoint">Checkpoint</option>
          </select>
        </div>
        <button class="green" onclick="runBatchSelected()" id="btnRunSelected" disabled>▶ Jalankan Terpilih (<span id="selectedCount">0</span>)</button>
        <button class="ghost" onclick="runBatchAll()" id="btnRunAll">▶ Jalankan Semua</button>
      </div>
      <div id="batchProgress" style="display:none; margin-top:10px;">
        <div style="display:flex; justify-content:space-between; font-size:12px; margin-bottom:4px;">
          <span id="batchProgressLabel">Memproses...</span>
          <span id="batchProgressCount">0/0</span>
        </div>
        <div style="background:var(--card-bg); height:8px; border-radius:6px; overflow:hidden;">
          <div id="batchProgressBar" style="background:var(--accent); height:100%; width:0%; transition:width .3s;"></div>
        </div>
        <div style="display:flex; gap:16px; margin-top:6px; font-size:12px;">
          <span style="color:var(--green);">✅ <span id="batchSuccess">0</span></span>
          <span style="color:var(--red);">❌ <span id="batchFailed">0</span></span>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-title">👥 Daftar Akun</div>
      <div class="dt-toolbar">
        <div class="dt-info" id="accTableInfo">Menampilkan 0 akun</div>
        <div class="dt-search">
          <div class="dt-search-wrap"><input type="text" id="accTableSearch" placeholder="Cari nama / email / status..."></div>
          <select id="accTablePlat" style="width:auto; padding:8px 12px; font-size:13px;">
            <option value="all">Semua Platform</option>
            <option value="fb">Facebook</option>
            <option value="ig">Instagram</option>
            <option value="tiktok">TikTok</option>
          </select>
        </div>
      </div>
      <div class="dt-scroll"><table id="accTable"><thead><tr>
        <th style="width:36px;"><input type="checkbox" id="selectAllAcc" onchange="toggleSelectAll(this)" title="Pilih semua di halaman ini"></th>
        <th class="dt-sort" data-col="platform">Platform</th>
        <th class="dt-sort" data-col="name">Nama</th>
        <th class="dt-sort" data-col="email">Email</th>
        <th class="dt-sort" data-col="status">Status</th>
        <th>Aksi</th>
      </tr></thead><tbody><tr><td colspan="6" class="history-empty">Memuat...</td></tr></tbody></table></div>
      <div class="dt-footer">
        <div class="dt-info" id="accTableCount">0 total</div>
        <div class="dt-pages" id="accTablePages"></div>
      </div>
    </div>
  </section>

  <!-- ============ POSTING ============ -->
  <section data-page="posting" style="display:none;">
    <div class="page-title">Posting Konten</div>
    <div class="page-sub" id="postSubTitle">Kirim konten sekarang atau jadwalkan</div>

    <div class="grid-2">
      <div class="card">
        <div class="card-title">⚡ Post Sekarang (langsung)</div>
        <form id="postForm">
          <label>Akun</label><select name="accountId" id="accSelectPost"><option>Muat akun...</option></select>
          <label>Generate AI (opsional)</label>
          <div style="display:flex; gap:8px; align-items:stretch;">
            <input name="aiPrompt" id="postAiPrompt" placeholder="mis. buatkan berita trading yang menarik">
            <button type="button" class="ghost" style="white-space:nowrap; padding:10px 14px;" onclick="genAI('postAiPrompt','postContent')">✨ Generate</button>
          </div>
          <label>Konten</label><textarea name="content" id="postContent" required placeholder="Konten akan terisi otomatis jika generate dipakai..."></textarea>
          <label>Gambar (opsional)</label><input name="media" type="file" accept="image/*">
          <button type="submit" class="green">🚀 Kirim Sekarang</button>
        </form>
      </div>
      <div class="card">
        <div class="card-title">🕒 Tambah Jadwal</div>
        <form id="schForm">
          <label>Akun</label><select name="accountId" id="accSelect"><option>Muat akun...</option></select>
          <label>Generate AI (opsional)</label>
          <div style="display:flex; gap:8px; align-items:stretch;">
            <input name="aiPrompt" id="schAiPrompt" placeholder="mis. buatkan berita trading yang menarik">
            <button type="button" class="ghost" style="white-space:nowrap; padding:10px 14px;" onclick="genAI('schAiPrompt','schContent')">✨ Generate</button>
          </div>
          <label>Konten</label><textarea name="content" id="schContent" required placeholder="Konten akan terisi otomatis jika generate dipakai..."></textarea>
          <label>Gambar (opsional)</label><input name="media" type="file" accept="image/*">
          <label>Ulangi</label>
          <select name="repeat" id="schRepeat">
            <option value="none">Sekali saja</option>
            <option value="daily">Harian</option>
            <option value="weekly">Mingguan</option>
            <option value="monthly">Bulanan</option>
          </select>
          <label>Waktu (jam lokal)</label><input name="time" type="time" required>
          <button type="submit">Jadwalkan</button>
        </form>
        <div style="margin-top:12px; display:flex; gap:8px; align-items:center;">
          <button class="green" style="flex:1;" onclick="runDue()">▶️ Jalankan Jadwal Lewat</button>
          <span class="muted" id="runResult" style="font-size:12px;"></span>
        </div>
      </div>
    </div>

    <div class="card" style="margin-top:18px;">
      <div class="card-title">📅 Jadwal Posting</div>
      <div class="scroll"><table id="schTable"><thead><tr><th>ID</th><th>Akun</th><th>Waktu</th><th>Ulangi</th><th>Status</th><th>Konten</th></tr></thead><tbody></tbody></table></div>
    </div>
  </section>

  <!-- ============ RIWAYAT ============ -->
  <section data-page="history" style="display:none;">
    <div class="page-title">Riwayat Posting</div>
    <div class="page-sub">Ringkasan & riwayat aktivitas per akun</div>

    <div class="card" style="margin-bottom:18px;">
      <div class="card-title">📊 Ringkasan per Akun</div>
      <div class="scroll"><table id="sumTable"><thead><tr><th>Akun</th><th>Platform</th><th>Status</th><th>Total</th><th>Berhasil</th><th>Gagal</th></tr></thead><tbody></tbody></table></div>
    </div>

    <div class="card">
      <div class="card-title">🕘 Log Riwayat</div>
      <div style="margin-bottom:12px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
        <label>Filter akun</label>
        <select id="histFilter" style="width:220px;"><option value="all">Semua akun</option></select>
        <button class="ghost" onclick="refreshHist()">↻ Segarkan</button>
        <button class="ghost" style="color:var(--red);" onclick="doCleanup()">🗑 Bersihkan Data Lama</button>
      </div>
      <div class="scroll"><table id="histTable"><thead><tr><th>Waktu</th><th>Akun</th><th>Status</th><th>Konten Posting</th><th>Hasil</th></tr></thead><tbody></tbody></table></div>
    </div>
  </section>

  <!-- ============ INSTAGRAM ============ -->
  <section data-page="igpost" style="display:none;">
    <div class="page-title">📸 Posting Instagram</div>
    <div class="page-sub">Posting ke Instagram memakai akun Facebook yang terhubung (media wajib)</div>
    <div class="grid-2">
      <div class="card">
        <div class="card-title">➕ Posting Baru IG</div>
        <form id="igForm">
          <label>Akun (profile Facebook)</label><select name="accountId" id="igAccSelect"><option>Muat akun...</option></select>
          <label>Generate AI (opsional)</label>
          <div style="display:flex; gap:8px; align-items:stretch;">
            <input name="aiPrompt" id="igAiPrompt" placeholder="mis. buat caption promo produk menarik">
            <button type="button" class="ghost" style="white-space:nowrap; padding:10px 14px;" onclick="genAI('igAiPrompt','igCaption')">✨ Generate</button>
          </div>
          <label>Gambar / Video (wajib)</label><input name="media" type="file" accept="image/*,video/*" required>
          <label>Caption</label><textarea name="caption" id="igCaption" placeholder="Tulis / generate caption postingan..."></textarea>
          <button type="submit" class="green">📤 Bagikan ke Instagram</button>
        </form>
      </div>
      <div class="card">
        <div class="card-title">💡 Login Instagram Sekali</div>
        <div class="muted" style="line-height:1.6; font-size:13px;">
          Instagram diakses memakai <b>profile Facebook yang sama</b> yang terhubung ke akun Instagram.<br><br>
          Untuk <b>awal</b>, login Instagram sekali lewat langkah ini (Connect with Facebook), lalu session-nya tersimpan permanent.<br><br>
        </div>
        <div style="display:flex; gap:8px; margin-top:6px; align-items:stretch;">
          <select id="igOpenSelect" style="flex:1;"><option>Muat akun...</option></select>
          <button type="button" onclick="openIgLogin()">🌐 Buka Instagram</button>
        </div>
        <div class="muted" style="font-size:12px; margin-top:8px;">Browser terbuka → klik "Continue as Facebook" / pilih akun → selesai. Setelah itu bisa auto-post.</div>
      </div>
    </div>
  </section>

  <!-- ============ PLACEHOLDER (Likes/Followers/Komentar) ============ -->
  <section data-page="likes" style="display:none;">
    <div class="page-title">👍 Likes</div>
    <div class="page-sub">Auto-like postingan Facebook secara terjadwal</div>

    <div class="grid-2">
      <div class="card">
        <div class="card-title">➕ Tambah Like Job</div>
        <form id="likeForm">
          <label>Akun</label><select name="accountId" id="likeAccSelect"><option>Muat akun...</option></select>
          <label>Nama (label)</label><input name="name" required placeholder="Like postingan promo">
          <label>URL Postingan</label><input name="postUrl" required placeholder="https://www.facebook.com/...">
          <button type="submit">Simpan Like Job</button>
        </form>
      </div>
      <div class="card">
        <div class="card-title">📋 Daftar Like Job</div>
        <div class="scroll"><table id="likeTable"><thead><tr><th>Nama</th><th>Akun</th><th>Status</th><th>Terakhir</th><th>Aksi</th></tr></thead><tbody></tbody></table></div>
      </div>
    </div>
  </section>
  
  <section data-page="smmlikes" style="display:none;">
    <div class="page-title">🚀 SMM Like Panel</div>
    <div class="page-sub">Order like dengan rotasi akun otomatis — cukup input link & jumlah like yang diinginkan</div>

    <div class="grid-2">
      <div class="card">
        <div class="card-title">➕ Buat Order Like Baru</div>
        <form id="smmLikeForm">
          <label>Platform</label>
          <select name="platform" onchange="updateSmmAccountInfo()">
            <option value="fb">Facebook</option>
            <option value="ig">Instagram</option>
          </select>
          <label>Nama Order</label>
          <input name="name" required placeholder="Boost postingan promo">
          <label>URL Target Postingan</label>
          <input name="postUrl" required placeholder="https://www.facebook.com/..." style="font-size:13px;">
          <label>Jumlah Like yang Diinginkan</label>
          <input name="targetLikes" type="number" required min="1" max="1000" placeholder="10" value="10" id="smmTargetLikes">
          <div style="background:var(--card2); padding:10px; border-radius:8px; font-size:12px; color:var(--muted); margin-top:10px;">
            💡 <strong>Penting:</strong> 1 akun = 1 like. Setiap akun hanya bisa like 1x per postingan.<br>
            <span id="smmAccountInfo" style="color:var(--accent); font-weight:600;">Loading...</span>
          </div>
          <button type="submit" class="green" style="margin-top:12px;">🚀 Buat Order</button>
        </form>
      </div>
      <div class="card">
        <div class="card-title">📊 Daftar Order Like</div>
        <div class="scroll">
          <table id="smmLikeTable">
            <thead>
              <tr>
                <th>Nama</th>
                <th>Platform</th>
                <th>Progress</th>
                <th>Status</th>
                <th>Dibuat</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="card" style="margin-top:18px;">
      <div class="card-title">ℹ️ Cara Kerja Sistem</div>
      <div style="font-size:13px; line-height:1.6; color:var(--muted);">
        <p style="margin-bottom:10px;">1. <strong>Penting:</strong> Setiap akun hanya bisa like <strong>1 kali</strong> per postingan</p>
        <p style="margin-bottom:10px;">2. <strong>Target Like:</strong> Jumlah like tidak boleh melebihi jumlah akun aktif Anda</p>
        <p style="margin-bottom:10px;">3. <strong>Contoh:</strong> Punya 10 akun aktif = maksimal 10 like untuk 1 postingan</p>
        <p style="margin-bottom:10px;">4. <strong>Eksekusi:</strong> Sistem akan menggunakan akun berbeda untuk setiap like</p>
        <p style="margin-bottom:10px;">5. <strong>Tracking:</strong> Progress ditampilkan real-time dengan detail akun yang sudah like</p>
        <p>6. <strong>Batch Processing:</strong> Sistem memproses 5 like sekaligus per eksekusi untuk efisiensi</p>
      </div>
    </div>
  </section>
  <section data-page="iglikes" style="display:none;">
    <div class="page-title">❤️ Like Instagram</div>
    <div class="page-sub">Auto-like postingan Instagram via URL (memakai akun/profile Facebook yang terhubung)</div>
    <div class="grid-2">
      <div class="card">
        <div class="card-title">➕ Tambah Like IG</div>
        <form id="igLikeForm">
          <label>Akun (profile Facebook)</label><select name="accountId" id="igLikeAccSelect"><option>Muat akun...</option></select>
          <label>Nama (label)</label><input name="name" required placeholder="Like postingan IG">
          <label>URL Postingan Instagram</label><input name="postUrl" required placeholder="https://www.instagram.com/p/...">
          <button type="submit">Simpan Like IG</button>
        </form>
      </div>
      <div class="card">
        <div class="card-title">📋 Daftar Like IG</div>
        <div class="scroll"><table id="igLikeTable"><thead><tr><th>Nama</th><th>Akun</th><th>Status</th><th>Terakhir</th><th>Aksi</th></tr></thead><tbody></tbody></table></div>
      </div>
    </div>
  </section>
  <section data-page="proxy" style="display:none;">
    <div class="page-title">🌐 Kelola Proxy</div>
    <div class="page-sub">Simpan daftar proxy & assign ke akun (1 akun = 1 IP)</div>
    <div class="grid-2">
      <div class="card">
        <div class="card-title">➕ Tambah Proxy</div>
        <form id="proxyForm">
          <label>Proxy (format host:port:user:pass — bisa banyak, pisah baris)</label>
          <textarea name="values" required style="min-height:120px;" placeholder="31.59.20.176:6754:oqxpanjc:ybmjzac6okqe&#10;31.56.127.193:7684:oqxpanjc:ybmjzac6okqe"></textarea>
          <button type="submit">Simpan Proxy</button>
        </form>
        <div style="margin-top:12px;">
          <button class="green" style="width:100%;" onclick="assignProxies()">🔗 Assign ke Akun yang Belum Punya Proxy</button>
          <button class="ghost" style="width:100%; margin-top:8px;" onclick="assignProxies(true)">🔄 Assign Ulang Semua Akun (timpa)</button>
        </div>
      </div>
      <div class="card">
        <div class="card-title">📋 Daftar Proxy</div>
        <div class="scroll"><table id="proxyTable"><thead><tr><th>ID</th><th>Nilai</th><th>Status</th><th>Aksi</th></tr></thead><tbody></tbody></table></div>
      </div>
    </div>
  </section>
  <section data-page="followers" style="display:none;">
    <div class="page-title">👤 Followers</div>
    <div class="page-sub">Fitur akan datang — kelola followers secara otomatis.</div>
    <div class="card"><div class="history-empty">🚧 Fitur belum tersedia</div></div>
  </section>
  <section data-page="comments" style="display:none;">
    <div class="page-title">💬 Komentar</div>
    <div class="page-sub">Fitur akan datang — kelola komentar secara otomatis.</div>
    <div class="card"><div class="history-empty">🚧 Fitur belum tersedia</div></div>
  </section>
</main>

