    toast('Memposting... tunggu.');
    try {
      const res=await api(`/api/accounts/${id}/post-now`,{method:'POST',body:f});
      if(res.error){ showErr('Post gagal: '+res.error); }
      else if(res.ok) toast('✓ Posting berhasil!');
      else { showErr('Post gagal: '+res.reason); }
    } catch(err){ showErr('Error: '+err.message); }
