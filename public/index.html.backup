// Edit Password Handler
let editPasswordAccountId = null;
let editPasswordOldPassword = '';
let isOldPasswordVisible = false;

async function editPassword(id, name, email) {
  editPasswordAccountId = id;
  $('#editPwAccountName').textContent = name;
  $('#editPwAccountEmail').textContent = email;
  $('#editPwInput').value = '';
  
  // Fetch old password
  try {
    const account = await api(`/api/accounts/${id}`);
    editPasswordOldPassword = account.password || '';
    $('#editPwOldDisplay').value = '••••••••';
    $('#editPwOldDisplay').dataset.password = editPasswordOldPassword;
    isOldPasswordVisible = false;
  } catch(err) {
    editPasswordOldPassword = '';
    $('#editPwOldDisplay').value = 'Error loading password';
  }
  
  $('#editPasswordModal').classList.add('show');
  $('#editPwInput').focus();
}

function toggleOldPassword() {
  const input = $('#editPwOldDisplay');
  const btn = $('#editPwToggle');
  
  if (isOldPasswordVisible) {
    input.value = '••••••••';
    btn.textContent = '👁️';
    isOldPasswordVisible = false;
  } else {
    input.value = input.dataset.password || '';
    btn.textContent = '🙈';
    isOldPasswordVisible = true;
  }
}

$('#editPwCancel').addEventListener('click', () => {
  $('#editPasswordModal').classList.remove('show');
  editPasswordAccountId = null;
});

$('#editPwSave').addEventListener('click', async () => {
  const newPassword = $('#editPwInput').value.trim();
  
  if (!newPassword) {
    toast('✗ Password tidak boleh kosong');
    return;
  }
  
  if (newPassword.length < 6) {
    toast('✗ Password minimal 6 karakter');
    return;
  }
  
  $('#editPasswordModal').classList.remove('show');
  
  // Show progress modal
  ProgressModal.show('Update Password', 'Sedang memperbarui password akun...', '🔑');
  
  const steps = [
    { icon: '🔍', title: 'Validasi Data', desc: 'Memeriksa password baru...' },
    { icon: '🔐', title: 'Enkripsi Password', desc: 'Mengamankan password...' },
    { icon: '💾', title: 'Update Database', desc: 'Menyimpan perubahan...' },
    { icon: '✅', title: 'Selesai', desc: 'Verifikasi update...' }
  ];
  
  ProgressModal.setSteps(steps);
  
  try {
    // Step 1: Validasi
    ProgressModal.setActive(0);
    await new Promise(resolve => setTimeout(resolve, 600));
    ProgressModal.setCompleted(0, 'Password valid ✓');
    
    // Step 2: Enkripsi
    ProgressModal.setActive(1);
    await new Promise(resolve => setTimeout(resolve, 700));
    ProgressModal.setCompleted(1, 'Password terenkripsi ✓');
    
    // Step 3: Update (actual API call)
    ProgressModal.setActive(2);
    ProgressModal.updateFooter('Menyimpan ke database...');
    
    const res = await fetch(`/api/accounts/${editPasswordAccountId}/password`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password: newPassword })
    });
    
    const result = await res.json();
    
    if (result.error) {
      ProgressModal.setFailed(2, '✗ ' + result.error);
      ProgressModal.updateFooter('Update gagal!');
      await new Promise(resolve => setTimeout(resolve, 2500));
      ProgressModal.hide();
      toast('✗ ' + result.error);
      return;
    }
    
    ProgressModal.setCompleted(2, 'Password tersimpan ✓');
    
    // Step 4: Verifikasi
    ProgressModal.setActive(3);
    await new Promise(resolve => setTimeout(resolve, 500));
    ProgressModal.setCompleted(3, 'Update berhasil ✓');
    
    ProgressModal.updateFooter('Password berhasil diperbarui! ✓');
    await new Promise(resolve => setTimeout(resolve, 1500));
    ProgressModal.hide();
    
    toast('✓ Password akun berhasil diperbarui');
    editPasswordAccountId = null;
    
  } catch (err) {
    ProgressModal.updateFooter('Terjadi kesalahan!');
    await new Promise(resolve => setTimeout(resolve, 2000));
    ProgressModal.hide();
    toast('✗ Error: ' + err.message);
  }
});

// Hist filter
$('#histFilter').addEventListener('change', () => refreshHist());

// ==== Modal Account Management ====
function openAddAccountModal() {
  document.getElementById('addAccountModal').classList.add('show');
  document.getElementById('modalAccForm').reset();
}

function closeAddAccountModal() {
  document.getElementById('addAccountModal').classList.remove('show');
}

function openBulkImportModal() {
  document.getElementById('bulkImportModal').classList.add('show');
  document.getElementById('modalBulkForm').reset();
  document.getElementById('importResult').style.display = 'none';
}

function closeBulkImportModal() {
  document.getElementById('bulkImportModal').classList.remove('show');
}

// Close modal when clicking overlay
document.addEventListener('click', (e) => {
  if (e.target.classList.contains('modal-overlay')) {
    closeAddAccountModal();
    closeBulkImportModal();
  }
});

// Handle Add Account Form Submit
document.getElementById('modalAccForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const f = new FormData(e.target);
  await withLoading(e.submitter, '⏳ Menyimpan...', async () => {
    const res = await api('/api/accounts', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: f.get('name'),
        email: f.get('email'),
        password: f.get('password'),
        proxy: f.get('proxy'),
        platform: f.get('platform')
      })
    });
    if (res.error) toast('✗ ' + res.error);
    else {
      toast('✓ Akun ditambahkan');
      closeAddAccountModal();
      refresh();
    }
  });
});

// Handle Bulk Import Form Submit
document.getElementById('modalBulkForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const f = new FormData(e.target);
  const file = f.get('file');
  const text = await file.text();
  const lines = text.split(/\r?\n/).filter(l => l.trim());
  
  const resultDiv = document.getElementById('importResult');
  resultDiv.style.display = 'block';
  resultDiv.innerHTML = '<div style="color:var(--amber);">⏳ Memproses ' + lines.length + ' baris...</div>';
  
  let success = 0, errors = 0;
  for (const line of lines) {
    const parts = line.includes('|') ? line.split('|') : line.split(',');
    if (parts.length < 4) { errors++; continue; }
    
    const [name, email, password, platform, proxy] = parts.map(p => p.trim());
    const res = await api('/api/accounts', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, email, password, platform: platform || 'fb', proxy: proxy || '' })
    });
    
    if (res.error) errors++;
    else success++;
  }
  
  resultDiv.innerHTML = `<div style="color:var(--green);">✓ Berhasil: ${success}</div><div style="color:var(--red);">✗ Gagal: ${errors}</div>`;
  toast(`Import selesai: ${success} berhasil, ${errors} gagal`);
  refresh();
});

// ==== Init ====
// default: active on Accounts panel
document.querySelector('.sidebar .nav-item[data-panel="accounts"]').classList.add('active');
updateSubTitles();
refresh();
setInterval(refresh, 15000);

// ==== Multiple Run init ====
document.getElementById('batchAction').addEventListener('change', updateBatchToolbar);
document.getElementById('batchStatus').addEventListener('change', function(){});
updateBatchToolbar();
</script>

</body>
</html>