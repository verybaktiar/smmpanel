async function genAI(promptId, contentId){
  const prompt = document.getElementById(promptId).value.trim();
  if(!prompt){ toast('Isi prompt AI dulu'); return; }
  const btn = event.target; btn.disabled = true;
  const prev = btn.textContent; btn.textContent = '⏳ Generate...';
  try {
    const res = await api('/api/ai/generate', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ prompt }) });
    if(res.error){ toast('✗ '+res.error); }
    else { document.getElementById(contentId).value = res.content; toast('✓ Konten AI dihasilkan'); }
  } catch(err){ toast('✗ Error: '+err.message); }
  btn.disabled = false; btn.textContent = prev;
}
async function doLogin(id){
  const ok = await showConfirm('Browser akan terbuka untuk login otomatis ke akun ini. Lanjutkan?', 'Ya, Login', 'Login Akun', '🔐');
  if(!ok) return;
  
  // Tampilkan progress modal
  ProgressModal.show('Proses Login', 'Sedang memproses login akun...', '🔐');
  
  // Definisikan langkah-langkah proses
  const steps = [
    { icon: '🔍', title: 'Memvalidasi Akun', desc: 'Memeriksa data akun...' },
    { icon: '🌐', title: 'Menyiapkan Browser', desc: 'Menginisialisasi browser profil...' },
    { icon: '🔗', title: 'Menghubungkan Proxy', desc: 'Mengatur koneksi proxy...' },
    { icon: '🔐', title: 'Melakukan Login', desc: 'Login ke platform...' },
    { icon: '💾', title: 'Menyimpan Session', desc: 'Menyimpan data login...' }
  ];
  
  ProgressModal.setSteps(steps);
  
  try {
    // Step 1: Validasi akun
    ProgressModal.setActive(0);
    await new Promise(resolve => setTimeout(resolve, 800));
    ProgressModal.setCompleted(0, 'Akun tervalidasi ✓');
    
    // Step 2: Menyiapkan browser
    ProgressModal.setActive(1);
    await new Promise(resolve => setTimeout(resolve, 1000));
    ProgressModal.setCompleted(1, 'Browser siap ✓');
    
    // Step 3: Koneksi proxy
    ProgressModal.setActive(2);
    await new Promise(resolve => setTimeout(resolve, 600));
    ProgressModal.setCompleted(2, 'Proxy terhubung ✓');
    
    // Step 4: Login (proses sebenarnya)
    ProgressModal.setActive(3);
    ProgressModal.updateFooter('Mohon tunggu, proses login sedang berlangsung...');
    
    const res = await api(`/api/accounts/${id}/login`, {method:'POST'});
    
    if(res.error) {
      ProgressModal.setFailed(3, '✗ ' + res.error);
      ProgressModal.updateFooter('Login gagal!');
      await new Promise(resolve => setTimeout(resolve, 2500));
      ProgressModal.hide();
      toast('✗ ' + res.error);
      return;
    }
    
    if(!res.ok) {
      ProgressModal.setFailed(3, '✗ ' + (res.reason || 'Login gagal'));
      ProgressModal.updateFooter('Login gagal!');
      await new Promise(resolve => setTimeout(resolve, 2500));
      ProgressModal.hide();
      toast('✗ Login gagal: ' + res.reason);
      return;
    }
    
    ProgressModal.setCompleted(3, 'Login berhasil ✓');
    
    // Step 5: Simpan session
    ProgressModal.setActive(4);
    await new Promise(resolve => setTimeout(resolve, 700));
    ProgressModal.setCompleted(4, 'Session tersimpan ✓');
    
    ProgressModal.updateFooter('Proses selesai! ✓');
    await new Promise(resolve => setTimeout(resolve, 1500));
    ProgressModal.hide();
    
    toast('✓ Login berhasil, session tersimpan');
    refresh();
    
  } catch(err) {
    ProgressModal.updateFooter('Terjadi kesalahan!');
    await new Promise(resolve => setTimeout(resolve, 2000));
    ProgressModal.hide();
    toast('✗ Error: ' + err.message);
  }
}
