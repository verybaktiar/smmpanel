// Disable tombol submit selama proses berjalan (cegah dobel klik).
async function withLoading(btn, label, fn){
  if(!btn) return fn();
  const prevHTML = btn.innerHTML;
  const prevCls = btn.className;
  btn.disabled = true;
  btn.classList.add('loading');
  btn.innerHTML = `<span class="spinner"></span>${label}`;
  try { return await fn(); }
  finally {
    btn.disabled = false;
    btn.className = prevCls;
    btn.innerHTML = prevHTML;
  }
}

