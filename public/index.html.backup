        Format: 1.2.3.4:8080:username:password
      </div>
      
      <div style="display:flex; gap:10px; margin-top:10px;">
        <button type="button" class="ghost" onclick="closeAddAccountModal()" style="flex:1;">Batal</button>
        <button type="submit" class="green" style="flex:2;">💾 Simpan Akun</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Bulk Import -->
<div id="bulkImportModal" class="modal-overlay">
  <div class="modal-form">
    <div class="modal-header">
      <h3>📥 Import Akun (Bulk)</h3>
      <button class="modal-close" onclick="closeBulkImportModal()">×</button>
    </div>
    <form id="modalBulkForm">
      <label>Upload File (TXT atau CSV)</label>
      <input name="file" type="file" accept=".txt,.csv" required>
      
      <div style="background:var(--card2); padding:12px; border-radius:8px; font-size:12px; color:var(--muted); margin:12px 0; line-height:1.6;">
        <strong style="color:var(--text);">📋 Format File:</strong><br>
        <code style="background:var(--bg); padding:2px 6px; border-radius:4px;">name|email|password|platform|proxy</code><br>
        atau<br>
        <code style="background:var(--bg); padding:2px 6px; border-radius:4px;">name,email,password,platform,proxy</code><br><br>
        
        <strong style="color:var(--text);">✏️ Contoh Isi File:</strong><br>
        <code style="display:block; background:var(--bg); padding:8px; border-radius:4px; margin-top:5px;">
Akun1|email1@gmail.com|pass123|fb|1.2.3.4:8080:user:pass<br>
Akun2|email2@gmail.com|pass456|fb<br>
Akun3,email3@gmail.com,pass789,ig,5.6.7.8:8080
        </code><br>
        
        <strong style="color:var(--text);">Platform:</strong> fb (Facebook), ig (Instagram), tiktok<br>
        <strong style="color:var(--text);">Proxy:</strong> Opsional, bisa dikosongkan
      </div>
      
      <div id="importResult" style="margin:10px 0; padding:10px; background:var(--card2); border-radius:8px; font-size:13px; display:none;"></div>
      
      <div style="display:flex; gap:10px; margin-top:10px;">
        <button type="button" class="ghost" onclick="closeBulkImportModal()" style="flex:1;">Batal</button>
        <button type="submit" class="green" style="flex:2;">📥 Import Sekarang</button>
      </div>
    </form>
  </div>
</div>

<script>
// ==== State ====
let currentPlatform = 'fb';   // fb | tiktok | ig (filter)
let accounts = [];
// DataTable state untuk tabel akun
const accTableState = {
  search: '',
  plat: 'all',
  sortCol: null,
  sortDir: 'asc',
  page: 0,
  pageSize: 8,
};

const PLAT_LABEL = { fb:'Facebook', tiktok:'TikTok', ig:'Instagram' };

// ==== Nav ====
document.querySelectorAll('.sidebar .nav-item').forEach((el) => {
  el.addEventListener('click', () => {
    document.querySelectorAll('.sidebar .nav-item').forEach(n => n.classList.remove('active'));
    el.classList.add('active');

    if (el.dataset.view) {
      currentPlatform = el.dataset.view;
      document.querySelectorAll('[data-page]').forEach(p => p.style.display='none');
      // Instagram punya panel khusus posting (igpost), bukan filter akun.
      const target = el.dataset.view === 'ig' ? 'igpost' : 'accounts';
      const sec = document.querySelector(`[data-page="${target}"]`);
      if (sec) sec.style.display='block';
      document.querySelectorAll('.sidebar .nav-item[data-panel]').forEach(n=>n.classList.remove('active'));
      updateSubTitles();
      refresh();
    } else if (el.dataset.panel) {
      document.querySelectorAll('[data-page]').forEach(p => p.style.display='none');
      const panel = document.querySelector(`[data-page="${el.dataset.panel}"]`);
      if (panel) panel.style.display='block';
      updateSubTitles();
      refresh();
    }
  });
});

function updateSubTitles(){
  document.getElementById('accSubTitle').textContent = 'Kelola & login akun ' + PLAT_LABEL[currentPlatform];
  document.getElementById('postSubTitle').textContent = 'Kirim konten sekarang atau jadwalkan (' + PLAT_LABEL[currentPlatform] + ')';
}

// ==== Helpers ====
const $ = (s) => document.querySelector(s);
async function api(url, opts) {
  try {
    const r = await fetch(url, opts);
    if (r.status === 429) {
      showErr('Rate limit exceeded. Tunggu beberapa detik lalu coba lagi.');
      return { error: 'Rate limit exceeded' };
    }
    const data = await r.json();
    return data;
  } catch (err) {
    showErr('Network error: ' + err.message);
    return { error: err.message };
  }
}
function toast(msg){ const t=$('#toast'); t.textContent=msg; t.classList.add('show'); setTimeout(()=>t.classList.remove('show'),2600); }
function showErr(msg){
  if(!msg) return;
  $('#errBannerMsg').textContent = msg;
  $('#errBanner').style.display = 'flex';
  setTimeout(dismissErr, 12000);
}
function dismissErr(){ $('#errBanner').style.display = 'none'; }
// Modal konfirmasi custom (menggantikan confirm bawaan).
function showConfirm(message, yesLabel = 'Ya, Lanjutkan', title = 'Konfirmasi', icon = '⚠️'){
  return new Promise((resolve) => {
    const modal = $('#confirmModal');
    $('#cfMsg').textContent = message;
    $('#cfTitle').textContent = title;
    $('#cfIcon').textContent = icon;
    $('#cfYes').textContent = yesLabel;
    modal.classList.add('show');

    const close = (val) => { modal.classList.remove('show'); cleanup(); resolve(val); };
    const onYes = () => close(true);
    const onNo = () => close(false);
    function cleanup(){
      $('#cfYes').removeEventListener('click', onYes);
      $('#cfNo').removeEventListener('click', onNo);
    }
    $('#cfYes').addEventListener('click', onYes);
    $('#cfNo').addEventListener('click', onNo);
  });
}
function badge(s){
  s=s||''; const cls = s.includes('fail')||s==='error'||s==='checkpoint' ? 'b-failed' : (s==='done'||s==='posted'||s==='like_ok' ? 'b-done' : (s==='pending'||s==='login_ok'||s==='running' ? 'b-pending' : ''));
  return `<span class="badge ${cls}">${s}</span>`;
}
function pbadge(p){ return `<span class="badge b-${p}">${PLAT_LABEL[p]||p}</span>`; }
function fmt(dt){ return dt ? new Date(dt).toLocaleString('id-ID') : '–'; }

// ==== Progress Modal ====
const ProgressModal = {
  steps: [],
  currentStep: 0,
  
  show(title, subtitle, icon='🔐') {
    $('#progressModal').classList.add('show');
    $('#progressTitle').textContent = title;
    $('#progressSubtitle').textContent = subtitle;
    $('#progressIcon').textContent = icon;
    $('#progressBar').style.width = '0%';
    this.steps = [];
    this.currentStep = 0;
  },
  
  hide() {
    $('#progressModal').classList.remove('show');
  },
  
  setSteps(stepsData) {
    this.steps = stepsData;
    this.currentStep = 0;
    this.renderSteps();
  },
  
  renderSteps() {
    const container = $('#progressSteps');
    container.innerHTML = this.steps.map((step, idx) => `
      <div class="progress-step" data-step="${idx}">
        <div class="step-icon">${step.icon}</div>
        <div class="step-content">
          <div class="step-title">${step.title}</div>
          <div class="step-desc">${step.desc}</div>
        </div>
      </div>
    `).join('');
  },
  
  updateStep(index, status, newDesc=null) {
    if (index >= this.steps.length) return;
    
    const stepEl = document.querySelector(`.progress-step[data-step="${index}"]`);
    if (!stepEl) return;
    
    stepEl.classList.remove('active', 'completed', 'failed');
    stepEl.classList.add(status);
    
    if (newDesc) {
      const descEl = stepEl.querySelector('.step-desc');
      if (descEl) descEl.textContent = newDesc;
      this.steps[index].desc = newDesc;
    }
    
    if (status === 'completed') {
      this.currentStep = index + 1;
    }
    
    const progress = Math.round(((index + (status === 'completed' ? 1 : 0.5)) / this.steps.length) * 100);
    $('#progressBar').style.width = progress + '%';
  },
  
  setActive(index) {
    this.updateStep(index, 'active');
  },
  
  setCompleted(index, newDesc=null) {
    this.updateStep(index, 'completed', newDesc);
  },
  
  setFailed(index, errorMsg) {
    this.updateStep(index, 'failed', errorMsg);
  },
  
  updateFooter(text) {
    $('#progressFooter').textContent = text;
  }
};

// ==== Load ====
async function loadStats(){
  const s = await api('/api/stats');
  if (!s.error) {
    $('#sAccounts').textContent = s.accounts || 0;
    $('#sToday').textContent = s.schedulesToday || 0;
    $('#sPosted').textContent = s.postedToday || 0;
    $('#sErrors').textContent = s.logErrors || 0;
  }
}
async function loadAccounts(){
  const result = await api('/api/accounts');
  if (result.error || !Array.isArray(result)) {
    accounts = [];
    renderAccTable();
    return;
  }
  accounts = result;
  renderAccTable();
  // Update SMM account info
  updateSmmAccountInfo();
  // isi dropdown
  const opts = accounts.map(a=>`<option value="${a.id}">${a.name} (${PLAT_LABEL[a.platform]})</option>`).join('') || '<option>Tidak ada akun</option>';
  $('#accSelect').innerHTML = opts;
  $('#accSelectPost').innerHTML = opts;
  const likeSel = $('#likeAccSelect');
  if(likeSel) likeSel.innerHTML = opts;
  const igSel = $('#igAccSelect');
  if(igSel) igSel.innerHTML = opts;
  const igOpenSel = $('#igOpenSelect');
  if(igOpenSel) igOpenSel.innerHTML = opts;
  const igLikeSel = $('#igLikeAccSelect');
  if(igLikeSel) igLikeSel.innerHTML = opts;
  // isi filter riwayat (semua akun + per nama)
  const names = [...new Set(accounts.map(a=>a.name))];
  $('#histFilter').innerHTML = '<option value="all">Semua akun</option>' + names.map(n=>`<option value="${n}">${n}</option>`).join('');
}

// ==== DataTable Akun ====
function accSortValue(a, col) {
  switch (col) {
    case 'platform': return PLAT_LABEL[a.platform] || a.platform || '';
    case 'name': return (a.name || '').toLowerCase();
    case 'email': return (a.email || '').toLowerCase();
    case 'status': return a.status || '';
    default: return '';
  }
}

function renderAccTable() {
  const tbody = $('#accTable tbody');
  let list = accounts.filter(a => {
    if (accTableState.plat !== 'all' && a.platform !== accTableState.plat) return false;
    if (accTableState.search) {
      const q = accTableState.search.toLowerCase();
      const hay = ((a.name||'') + ' ' + (a.email||'') + ' ' + (a.status||'')).toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });

  if (accTableState.sortCol) {
    const col = accTableState.sortCol;
    const dir = accTableState.sortDir === 'asc' ? 1 : -1;
    list.sort((a, b) => {
      const va = accSortValue(a, col), vb = accSortValue(b, col);
      return va < vb ? -1 * dir : va > vb ? 1 * dir : 0;
    });
  }

  const total = list.length;
  const totalPages = Math.max(1, Math.ceil(total / accTableState.pageSize));
  if (accTableState.page >= totalPages) accTableState.page = totalPages - 1;
  const page = Math.min(accTableState.page, totalPages - 1);
  const start = page * accTableState.pageSize;
  const pageList = list.slice(start, start + accTableState.pageSize);

  $('#accTableInfo').textContent = total === 0
    ? 'Tidak ada akun'
    : `Menampilkan ${start+1}–${Math.min(start+accTableState.pageSize, total)} dari ${total} akun`;
  $('#accTableCount').textContent = `${total} total akun`;

  if (!pageList.length) {
    tbody.innerHTML = `<tr><td colspan="6"><div class="dt-empty"><div class="dt-empty-icon">📭</div>Tidak ada akun ditemukan</div></td></tr>`;
  } else {
    tbody.innerHTML = pageList.map(a => {
      const active = a.status==='active';
      const action = active
        ? `<button class="act-main" onclick="openBrowser(${a.id})">Buka</button>`
        : `<button class="act-main green" onclick="doLogin(${a.id})">Login</button>`;
      const initial = (a.name || '?').charAt(0).toUpperCase();
      const platKey = ['fb','ig','tiktok'].includes(a.platform) ? a.platform : 'other';
      const dotCls = (a.status==='active') ? 'good' : ((a.status==='checkpoint'||a.status==='pending') ? 'warn' : 'bad');
      const platIc = a.platform==='fb' ? '🔵' : (a.platform==='ig' ? '📸' : (a.platform==='tiktok' ? '🎵' : '🌐'));
      const safeName = escapeHtml(a.name||'').replace(/'/g,"\\'");
      const safeEmail = escapeHtml(a.email||'').replace(/'/g,"\\'");
      return `<tr>
        <td style="text-align:center;"><input type="checkbox" class="acc-check" value="${a.id}" data-name="${safeName}" onchange="updateBatchCount()"></td>
        <td><div class="platform-cell"><span class="platform-ic ${a.platform}">${platIc}</span><span class="badge b-${a.platform}">${PLAT_LABEL[a.platform]||a.platform}</span></div></td>
        <td><div class="acc-cell"><div class="acc-avatar ${platKey}">${initial}</div><div><div class="acc-name">${escapeHtml(a.name)}</div></div></div></td>
        <td><div class="acc-email">${escapeHtml(a.email)}</div></td>
        <td><div class="status-cell"><span class="status-dot ${dotCls}"></span>${badge(a.status)}</div></td>
        <td><div class="act-col">${action}<button class="act-edit" onclick="editPassword(${a.id},'${safeName}','${safeEmail}')" title="Edit Password">🔑</button><button class="act-del" onclick="deleteAccount(${a.id})">Hapus</button></div></td>
      </tr>`;
    }).join('');
  }

  // Pagination buttons
  const pagesEl = $('#accTablePages');
  if (totalPages <= 1) {
    pagesEl.innerHTML = '';
  } else {
    let html = `<button onclick="accTableGo(0)" ${page===0?'disabled':''}>«</button>`;
    const startP = Math.max(0, page-2);
    const endP = Math.min(totalPages-1, page+2);
    for (let i=startP; i<=endP; i++) {
      html += `<button class="${i===page?'active':''}" onclick="accTableGo(${i})">${i+1}</button>`;
    }
    html += `<button onclick="accTableGo(${totalPages-1})" ${page===totalPages-1?'disabled':''}>»</button>`;
    pagesEl.innerHTML = html;
  }

  // Update sort indicator on headers
  document.querySelectorAll('#accTable th.dt-sort').forEach(th => {
    th.classList.toggle('asc', accTableState.sortCol===th.dataset.col && accTableState.sortDir==='asc');
    th.classList.toggle('desc', accTableState.sortCol===th.dataset.col && accTableState.sortDir==='desc');
  });

  // Reset pilihan seleksi (checklist direset saat tabel dirender ulang)
  const selectAll = document.getElementById('selectAllAcc');
  if (selectAll) selectAll.checked = false;
  updateBatchCount();
}

function accTableGo(p) {
  accTableState.page = Math.max(0, p);
  renderAccTable();
}

// Event listeners DataTable akun
document.getElementById('accTableSearch').addEventListener('input', (e) => {
  accTableState.search = e.target.value.trim();
  accTableState.page = 0;
  renderAccTable();
});
document.getElementById('accTablePlat').addEventListener('change', (e) => {
  accTableState.plat = e.target.value;
  accTableState.page = 0;
  renderAccTable();
});
document.querySelectorAll('#accTable th.dt-sort').forEach(th => {
  th.addEventListener('click', () => {
    const col = th.dataset.col;
    if (accTableState.sortCol === col) {
      accTableState.sortDir = accTableState.sortDir === 'asc' ? 'desc' : 'asc';
    } else {
      accTableState.sortCol = col;
      accTableState.sortDir = 'asc';
    }
    accTableState.page = 0;
    renderAccTable();
  });
});

function updateSmmAccountInfo() {
  const infoEl = document.getElementById('smmAccountInfo');
  if (!infoEl) return;
  
  const platformSelect = document.querySelector('#smmLikeForm select[name="platform"]');
  const platform = platformSelect ? platformSelect.value : 'fb';
  
  const activeAccounts = accounts.filter(a => a.status === 'active' && a.platform === platform);
  const count = activeAccounts.length;
  
  const platformName = platform === 'fb' ? 'Facebook' : platform === 'ig' ? 'Instagram' : platform.toUpperCase();
  
  if (count === 0) {
    infoEl.textContent = `⚠️ Tidak ada akun ${platformName} aktif. Login akun terlebih dahulu.`;
    infoEl.style.color = 'var(--red)';
  } else {
    infoEl.textContent = `✓ ${count} akun ${platformName} aktif tersedia. Maksimal ${count} like per order.`;
    infoEl.style.color = 'var(--green)';
  }
}

// ==== MULTIPLE RUN ====
let batchPollTimer = null;

function updateBatchToolbar() {
  const action = $('#batchAction').value;
  $('#batchUrlGroup').style.display = (action === 'like' || action === 'ig-like') ? '' : 'none';
  $('#batchContentGroup').style.display = (action === 'post' || action === 'post-ig') ? '' : 'none';
}

function toggleSelectAll(checkbox) {
  document.querySelectorAll('#accTable tbody .acc-check').forEach(cb => {
    cb.checked = checkbox.checked;
  });
  updateBatchCount();
}

function updateBatchCount() {
  const selected = document.querySelectorAll('#accTable tbody .acc-check:checked').length;
  $('#selectedCount').textContent = selected;
  $('#btnRunSelected').disabled = selected === 0;
}

function getSelectedAccountIds() {
  return Array.from(document.querySelectorAll('#accTable tbody .acc-check:checked')).map(cb => Number(cb.value));
}

function startBatchProgress(total) {
  const el = $('#batchProgress');
  el.style.display = '';
  $('#batchProgressLabel').textContent = `Memproses ${total} akun...`;
  $('#batchProgressCount').textContent = `0/${total}`;
  $('#batchProgressBar').style.width = '0%';
  $('#batchSuccess').textContent = '0';
  $('#batchFailed').textContent = '0';
  $('#btnRunSelected').disabled = true;
  $('#btnRunAll').disabled = true;
}

function stopBatchProgress() {
  clearInterval(batchPollTimer);
  batchPollTimer = null;
  $('#btnRunAll').disabled = false;
  updateBatchCount();
}

function updateBatchProgressUI(p) {
  if (!p) return;
  const total = p.total || 1;
  const pct = Math.min(100, Math.round((p.done / total) * 100));
  $('#batchProgressCount').textContent = `${p.done}/${total}`;
  $('#batchProgressBar').style.width = pct + '%';
  $('#batchSuccess').textContent = p.success || 0;
  $('#batchFailed').textContent = p.failed || 0;
  $('#batchProgressLabel').textContent = p.current
    ? `Mengerjakan: ${p.current} (${p.done}/${total})`
    : `Memproses ${p.action || ''} ${p.done}/${total}`;
  if (!p.running && total > 0 && p.done >= total) {
    $('#batchProgressLabel').textContent = `Selesai! ✅ ${p.success} berhasil, ❌ ${p.failed} gagal`;
    stopBatchProgress();
  }
}

function pollBatchProgress() {
  clearInterval(batchPollTimer);
  batchPollTimer = setInterval(async () => {
    try {
      const p = await api('/api/batch/progress');
      if (!p.error) updateBatchProgressUI(p);
    } catch (e) { /* ignore */ }
  }, 1500);
}

async function runBatchSelected() {
  const accountIds = getSelectedAccountIds();
  if (!accountIds.length) { toast('Pilih minimal 1 akun dulu'); return; }
  const action = $('#batchAction').value;
  const url = $('#batchUrl').value.trim();
  const content = $('#batchContent').value.trim();

  if ((action === 'like' || action === 'ig-like') && !url) { toast('URL wajib diisi untuk aksi like'); return; }
  if ((action === 'post' || action === 'post-ig') && !content) { toast('Konten wajib diisi untuk aksi post'); return; }

  startBatchProgress(accountIds.length);
  pollBatchProgress();
  try {
    const res = await api('/api/batch/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ accountIds, action, url, content })
    });
    if (res.error) {
      toast('✗ ' + res.error);
      stopBatchProgress();
      $('#batchProgress').style.display = 'none';
      return;
    }
    toast(`Batch selesai: ${res.success} berhasil, ${res.failed} gagal`);
    refresh();
  } catch (err) {
    toast('✗ Error: ' + err.message);
    stopBatchProgress();
  }
}

async function runBatchAll() {
  const action = $('#batchAction').value;
  const url = $('#batchUrl').value.trim();
  const content = $('#batchContent').value.trim();
  const status = $('#batchStatus').value;

  if ((action === 'like' || action === 'ig-like') && !url) { toast('URL wajib diisi untuk aksi like'); return; }
  if ((action === 'post' || action === 'post-ig') && !content) { toast('Konten wajib diisi untuk aksi post'); return; }

  startBatchProgress(0);
  pollBatchProgress();
  try {
    const res = await api('/api/batch/run-all', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action, url, content, status })
    });
    if (res.error) {
      toast('✗ ' + res.error);
      stopBatchProgress();
      $('#batchProgress').style.display = 'none';
      return;
    }
    toast(`Batch selesai: ${res.success} berhasil, ${res.failed} gagal`);
    refresh();
  } catch (err) {
    toast('✗ Error: ' + err.message);
    stopBatchProgress();
  }
}

async function loadSchedules(){
  const list = await api('/api/schedules');
  const arr = Array.isArray(list) ? list : [];
  $('#schTable tbody').innerHTML = arr.length ? arr.map(s=>`<tr><td>${s.id}</td><td>${s.account}</td><td>${fmt(s.scheduled_at)}</td><td class="muted">${s.repeat&&s.repeat!=='none'?s.repeat:'–'}</td><td>${badge(s.status)}</td><td>${escapeHtml(s.content)}</td></tr>`).join('') : '<tr><td colspan="6" class="history-empty">Belum ada jadwal</td></tr>';
}
async function loadHist(){
  const list = await api('/api/logs');
  const arr = Array.isArray(list) ? list : [];
  const filt = $('#histFilter').value;
  const rows = (filt==='all') ? arr : arr.filter(l => l.account === filt);
  $('#histTable tbody').innerHTML = rows.length
    ? rows.map(l=>`<tr>
        <td style="white-space:nowrap;">${fmt(l.created_at)}</td>
        <td>${pbadge(l.platform)} ${l.account}</td>
        <td>${badge(l.status)}</td>
        <td>${escapeHtml(l.content_text || '–')}</td>
        <td class="muted">${escapeHtml(l.message || '')}</td>
      </tr>`).join('')
    : '<tr><td colspan="5" class="history-empty">Belum ada riwayat</td></tr>';
}
function escapeHtml(s){ if(!s) return s; return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
async function loadSummary(){
  const rows = await api('/api/accounts/summary');
  const arr = Array.isArray(rows) ? rows : [];
  $('#sumTable tbody').innerHTML = arr.length
    ? rows.map(s=>`<tr>
        <td>${s.name}</td>
        <td>${pbadge(s.platform)}</td>
        <td>${badge(s.status)}</td>
        <td>${s.total??0}</td>
        <td style="color:var(--green);">${s.berhasil??0}</td>
        <td style="color:var(--red);">${s.gagal??0}</td>
      </tr>`).join('')
    : '<tr><td colspan="6" class="history-empty">Belum ada akun</td></tr>';
}
async function loadLikeJobs(){
  const list = await api('/api/likes');
  const arr = Array.isArray(list) ? list : [];
  $('#likeTable tbody').innerHTML = arr.length
    ? list.map(j=>`<tr>
        <td>${escapeHtml(j.name)}</td>
        <td>${escapeHtml(j.account_name||'')}</td>
        <td>${badge(j.status)}</td>
        <td class="muted">${j.last_run_at?fmt(j.last_run_at):'–'}</td>
        <td><div class="act-col" style="min-width:80px;">
          <button class="act-main" onclick="runLike(${j.id})">Like</button>
          <button class="act-del" onclick="deleteLikeJob(${j.id})">Hapus</button>
        </div></td>
      </tr>`).join('')
    : '<tr><td colspan="5" class="history-empty">Belum ada like job</td></tr>';
}
async function runLike(id){
  toast('Membuka postingan & like...');
  const res = await api(`/api/likes/${id}/run`, { method:'POST' });
  if(res.error) showErr('Like gagal: '+res.error);
  else if(res.ok) toast('✓ Berhasil like');
  else showErr('Like gagal: '+res.reason);
  refresh();
}
async function deleteLikeJob(id){
  const ok = await showConfirm('Hapus like job ini?', 'Ya, Hapus', 'Hapus Like Job', '👍');
  if(!ok) return;
  const res = await api(`/api/likes/${id}`, { method:'DELETE' });
  toast(res.error ? '✗ '+res.error : '✓ Like job dihapus');
  refresh();
}

// ==== SMM Like Orders ====
async function loadSmmLikeOrders(){
  const list = await api('/api/smm/like-orders');
  const arr = Array.isArray(list) ? list : [];
  $('#smmLikeTable tbody').innerHTML = arr.length
    ? list.map(o => {
        const progress = o.target_likes > 0 ? Math.round((o.completed_likes / o.target_likes) * 100) : 0;
        const statusColor = o.status === 'completed' ? 'b-done' : (o.status === 'processing' ? 'b-pending' : '');
        return `<tr>
          <td>${escapeHtml(o.name)}</td>
          <td>${pbadge(o.platform)}</td>
          <td>
            <div style="font-size:12px; color:var(--muted);">${o.completed_likes} / ${o.target_likes}</div>
            <div style="background:var(--card2); height:6px; border-radius:4px; overflow:hidden; margin-top:4px;">
              <div style="background:var(--accent); height:100%; width:${progress}%; transition:.3s;"></div>
            </div>
          </td>
          <td><span class="badge ${statusColor}">${o.status}</span></td>
          <td class="muted">${fmt(o.created_at)}</td>
          <td><div class="act-col" style="min-width:120px;">
            ${o.status !== 'completed' ? `<button class="act-main green" onclick="runSmmOrder(${o.id})">▶ Jalankan</button>` : ''}
            <button class="act-main" onclick="viewSmmOrder(${o.id})" title="Detail">📊</button>
            <button class="act-del" onclick="deleteSmmOrder(${o.id})">Hapus</button>
          </div></td>
        </tr>`;
      }).join('')
    : '<tr><td colspan="6" class="history-empty">Belum ada order like</td></tr>';
}

async function runSmmOrder(id){
  ProgressModal.show('Menjalankan Order Like', 'Memproses like dengan rotasi akun...', '🚀');
  
  const steps = [
    { icon: '🔍', title: 'Validasi Order', desc: 'Memeriksa order dan akun...' },
    { icon: '👥', title: 'Rotasi Akun', desc: 'Mengambil akun sesuai giliran...' },
    { icon: '👍', title: 'Eksekusi Like', desc: 'Memproses like...' },
    { icon: '📊', title: 'Update Progress', desc: 'Menyimpan hasil...' }
  ];
  
  ProgressModal.setSteps(steps);
  
  try {
    ProgressModal.setActive(0);
    await new Promise(resolve => setTimeout(resolve, 600));
    ProgressModal.setCompleted(0, 'Order valid ✓');
    
    ProgressModal.setActive(1);
    await new Promise(resolve => setTimeout(resolve, 700));
    ProgressModal.setCompleted(1, 'Akun siap ✓');
    
    ProgressModal.setActive(2);
    ProgressModal.updateFooter('Sedang memproses like (batch 5)...');
    
    const res = await fetch(`/api/smm/like-orders/${id}/run`, { method: 'POST' });
    const result = await res.json();
    
    if (result.error) {
      ProgressModal.setFailed(2, '✗ ' + result.error);
      ProgressModal.updateFooter('Eksekusi gagal!');
      await new Promise(resolve => setTimeout(resolve, 2500));
      ProgressModal.hide();
      toast('✗ ' + result.error);
      return;
    }
    
    ProgressModal.setCompleted(2, `${result.processed} like diproses ✓`);
    
    ProgressModal.setActive(3);
    await new Promise(resolve => setTimeout(resolve, 500));
    ProgressModal.setCompleted(3, `Progress: ${result.completed}/${result.target} ✓`);
    
    ProgressModal.updateFooter(`Berhasil! ${result.completed}/${result.target} likes completed`);
    await new Promise(resolve => setTimeout(resolve, 1500));
    ProgressModal.hide();
    
    toast(`✓ ${result.processed} like diproses. Progress: ${result.completed}/${result.target}`);
    refresh();
    
  } catch (err) {
    ProgressModal.updateFooter('Terjadi kesalahan!');
    await new Promise(resolve => setTimeout(resolve, 2000));
    ProgressModal.hide();
    toast('✗ Error: ' + err.message);
  }
}

async function viewSmmOrder(id){
  const order = await api(`/api/smm/like-orders/${id}`);
  if(order.error){ showErr(order.error); return; }
  
  const execList = order.executions.map(e => {
    const statusIcon = e.status === 'completed' ? '✅' : (e.status === 'failed' ? '❌' : '⏳');
    const statusText = e.status === 'completed' ? 'Berhasil' : (e.status === 'failed' ? 'Gagal' : 'Pending');
    return `<tr>
      <td>${statusIcon}</td>
      <td>${escapeHtml(e.account_name)}</td>
      <td>${escapeHtml(e.account_email)}</td>
      <td><span class="badge ${e.status === 'completed' ? 'b-done' : (e.status === 'failed' ? 'b-failed' : 'b-pending')}">${statusText}</span></td>
      <td class="muted" style="font-size:11px;">${e.executed_at ? fmt(e.executed_at) : '–'}</td>
      <td class="muted" style="font-size:11px;">${e.error_message || '–'}</td>
    </tr>`;
  }).join('');
  
  const progress = Math.round((order.completed_likes / order.target_likes) * 100);
  
  alert(`Detail Order: ${order.name}\n\nLink: ${order.post_url}\nTarget: ${order.target_likes} likes\nCompleted: ${order.completed_likes} likes\nProgress: ${progress}%\nStatus: ${order.status}\n\nLihat console untuk detail eksekusi per akun.`);
  
  console.log('=== Detail Order ===');
  console.log('Nama:', order.name);
  console.log('Link:', order.post_url);
  console.log('Progress:', order.completed_likes, '/', order.target_likes);
  console.log('Status:', order.status);
  console.log('\n=== Eksekusi Per Akun ===');
  console.table(order.executions.map(e => ({
    Akun: e.account_name,
    Email: e.account_email,
    Status: e.status,
    Waktu: e.executed_at || '-',
    Error: e.error_message || '-'
  })));
}

