          <input type="password" id="editPwOldDisplay" readonly style="flex:1; padding:8px; border:1px solid var(--border); border-radius:6px; background:var(--bg); color:var(--text); font-size:13px; font-family:monospace;">
          <button type="button" id="editPwToggle" onclick="toggleOldPassword()" style="padding:8px 12px; border:1px solid var(--border); border-radius:6px; background:var(--card); color:var(--text); cursor:pointer; font-size:12px;">👁️</button>
