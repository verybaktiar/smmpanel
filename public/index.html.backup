async function assignProxies(overwrite){
  const ok = await showConfirm(
    overwrite
      ? 'Assign ULANG SEMUA akun? Proxy yang sudah ada akan DITIMPA sesuai urutan (proksi #i → akun #i).'
      : 'Assign proxy hanya ke akun yang BELUM punya proxy (proksi #i → akun #i)?',
    'Ya, Assign', 'Assign Proxy', '🔗');
  if(!ok) return;
  const res = await api('/api/proxies/assign', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ overwrite: !!overwrite }) });
  toast(res.error ? '✗ '+res.error : '✓ '+res.assigned+' akun diberi proxy');
  refresh();
}
