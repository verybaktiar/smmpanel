document.getElementById('smmLikeForm').addEventListener('submit', async (e) => {
  e.preventDefault(); const f=new FormData(e.target);
  
  const targetLikes = parseInt(f.get('targetLikes'));
  const platform = f.get('platform');
  
  // Validasi jumlah akun aktif
  const activeAccounts = accounts.filter(a => a.status === 'active' && a.platform === platform);
  
  if (activeAccounts.length === 0) {
    toast(`✗ Tidak ada akun ${platform.toUpperCase()} aktif. Login akun terlebih dahulu.`);
    return;
  }
  
  if (targetLikes > activeAccounts.length) {
    toast(`✗ Target ${targetLikes} like melebihi akun aktif (${activeAccounts.length}). Setiap akun hanya bisa like 1x.`);
    return;
  }
  
  if(targetLikes < 1 || targetLikes > 1000) {
    toast('✗ Jumlah like harus antara 1-1000');
    return;
  }
  
  await withLoading(e.submitter, '⏳ Membuat order...', async () => {
    const res=await api('/api/smm/like-orders',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        name:f.get('name'),
        postUrl:f.get('postUrl'),
        targetLikes:targetLikes,
        platform:platform
      })
    });
    if(res.error) toast('✗ '+res.error); 
    else { 
      toast(`✓ Order dibuat! ${targetLikes} akun ${platform.toUpperCase()} akan like postingan ini (1 akun = 1 like)`); 
      e.target.reset(); 
      refresh(); 
    }
  });
});
document.getElementById('proxyForm').addEventListener('submit', async (e) => {
  e.preventDefault(); const f=new FormData(e.target);
  const raw = (f.get('values')||'').split('\n').map(s=>s.trim()).filter(Boolean);
  await withLoading(e.submitter, '⏳ Menyimpan...', async () => {
    const res=await api('/api/proxies',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({values:raw})});
    if(res.error) toast('✗ '+res.error); else { toast('✓ Proxy disimpan'); e.target.reset(); refresh(); }
  });
});
