# ==================== DATABASE ====================
DB_PATH=./database.db

# ==================== SERVER ====================
PORT=3000

# ==================== SECURITY ====================
# Optional - set untuk production
API_KEY=your-secret-api-key-here
CORS_ORIGIN=*

# Encryption Key (Auto-generated jika kosong)
ENCRYPTION_KEY=

# ==================== RATE LIMITING ====================
MAX_ACTIONS_PER_HOUR=20

# ==================== QUEUE SETTINGS ====================
QUEUE_BATCH_SIZE=2
QUEUE_MIN_DELAY_SECONDS=30
QUEUE_MAX_DELAY_SECONDS=90

# ==================== HEALTH CHECK ====================
HEALTH_CHECK_TIMEOUT=30000

# ==================== PROXY SETTINGS ====================
PROXY_TEST_TIMEOUT=10000

# ==================== BACKUP SYSTEM ====================
# Maximum number of backups to keep (older ones will be deleted automatically)
MAX_BACKUPS=30

# Enable automatic daily backups
BACKUP_AUTO_ENABLED=true

# Backup retention in days
BACKUP_RETENTION_DAYS=30

# ==================== CAPTCHA SOLVER (2Captcha) ====================
# Get your API key from: https://2captcha.com/
CAPTCHA_API_KEY=your_2captcha_api_key_here

# ==================== AI CONTENT GENERATION ====================
# Nilai di bawah jadi default. Semuanya bisa diubah tanpa edit file dari
# halaman AI -> Koneksi AI (disimpan di config/ai.json).
# Endpoint harus OpenAI-compatible, biasanya berakhiran /v1.
AI_BASE_URL=https://tokenharbor.ai/v1
AI_API_KEY=your_api_key_here
AI_MODEL=deepseek-v4-flash:free

# Opsional: token Pollinations untuk gambar posting (menghapus batas 1 gambar/45 dtk).
POLLINATIONS_TOKEN=

# ==================== NOTIFICATION SYSTEM ====================

# Telegram Bot Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Discord Webhook Notifications
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Email Notifications
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# SMS Notifications (optional - via Twilio or similar)
SMS_ENABLED=false
SMS_API_KEY=your_sms_api_key
SMS_FROM_NUMBER=+1234567890
SMS_TO_NUMBER=+1234567890

# ==================== ACCOUNT WARMING ====================
# Account warming is automatic, no config needed
# Stages: stage1 (3 days) -> stage2 (4 days) -> stage3 (7 days) -> stage4 (ongoing)

# ==================== FOLLOWING AUTOMATION ====================
# Limits for following/unfollowing actions
FOLLOW_PER_HOUR=20
FOLLOW_PER_DAY=200
UNFOLLOW_DELAY_DAYS=3

# ==================== FACEBOOK AUTO-SIGNUP ====================
# Ammail Worker Configuration (Temp Email Service)
AMMAIL_BASE_URL=https://your-worker.workers.dev
AMMAIL_API_KEY=your_ammail_api_key_here
AMMAIL_DOMAIN=yourdomain.com
AMMAIL_TIMEOUT=20000

# Facebook Auto-Creation Settings
FB_AUTO_HEADLESS=true
FB_AUTO_MIN_AGE=18
FB_AUTO_MAX_AGE=45
